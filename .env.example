# Copy to .env and fill in YOUR data. Never commit .env (git ignores it).
# Empty values must be filled in; the others are defaults that work as they are.

# --- Cloudflare: account and API token (secrets) ---
CLOUDFLARE_ACCOUNT_ID=
# Custom API token with Workers AI, Vectorize and D1 permissions only, limited to your account
CLOUDFLARE_API_TOKEN=

# --- Workers AI models ---
# The bot reads the same values from bot/wrangler.jsonc: change them in both places
CF_EMBED_MODEL=@cf/baai/bge-m3
CF_LLM_MODEL=@cf/google/gemma-4-26b-a4b-it

# --- Vectorize and D1 ---
# Same name as index_name in bot/wrangler.jsonc
VECTORIZE_INDEX=unirag-inf
# Printed by "wrangler d1 create"; put it in bot/wrangler.jsonc too (database_id)
D1_DATABASE_ID=

# --- Telegram (secrets) ---
# Used here only by setup/webhook.py and setup/commands.py; the bot gets them with
# "npx wrangler secret put" (see docs/installation.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Crawler ---
# Name in the User-Agent: keep the UniRAG-inf prefix
CRAWLER_NAME=UniRAG-inf-copy
# Required: YOUR email; the crawler introduces itself to the site with it and does not start without it
CRAWLER_CONTACT=
# Optional: a page that explains your crawler (e.g. your copy of docs/crawler.md)
CRAWLER_INFO_URL=
# 0 = reduced mode for development (few requests, local copy in cache/); 1 = full run (GitHub Actions)
CRAWLER_FULL=0

# --- Pipeline ---
# 1 = errors in the log also show the values that explain them (e.g. the words a PDF table lost).
# Leave it empty if your logs are public (e.g. GitHub Actions in a public repository): they are
# texts from UniCa's website
PIPELINE_DETAILS=
